# .htaccess — Apache config for the hosted (PHP) deployment.
# Ignored by GitHub Pages and by `php -S` / static servers, so it only takes
# effect on the real Apache host. Needs mod_rewrite + mod_headers (standard on
# most shared hosting).

# --- Force HTTPS -----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Security headers (site-wide) ------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # CSP: everything from same origin, the same policy as Sinless. No
  # 'unsafe-inline' for scripts (there are no inline <script> blocks). Inline
  # STYLE attributes produced by el() need 'unsafe-inline' in style-src. Fonts
  # are self-hosted in static/fonts/. Generate Summary on an Encyclopedia entry
  # asks Wikipedia from the browser, so connect-src allows en.wikipedia.org.
  # Keep this in step with the meta tag in index.html: a browser applies both.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.openverse.org https://www.artic.edu https://images.metmuseum.org https://ids.si.edu https://*.wixmp.com https://*.deviantart.net; font-src 'self'; connect-src 'self' https://en.wikipedia.org; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
</IfModule>

# --- Make browsers check for a new app after each deploy -------------------
# The page, scripts and styles keep their names between releases, so without
# this a browser can keep running last week's app.js (missing new tabs, say)
# for days. no-cache still lets it reuse its copy when the server says it's unchanged.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Installable app ------------------------------------------------------
# Older Apache builds don't know the manifest's extension.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Don't serve secrets / SQL / docs / tooling / dotfiles -----------------
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|py|sh)$">
  Require all denied
</FilesMatch>
# Block dotfile *names* (e.g. .htaccess, .gitignore).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# Block the .git *directory* itself. A request for /.git/HEAD asks for a
# non-dot filename inside a dot-directory, which the FilesMatch above does NOT
# catch — without this the whole repo/history would be downloadable when the
# clone lives under the web root. `.well-known` is left reachable so ACME/
# Let's Encrypt still works.
<IfModule mod_alias.c>
  RedirectMatch 404 (?:^|/)\.git
</IfModule>
# The browser-test harness (tests/, including its test-only sign-in), the
# climate-normals tooling (tools/), the schema/migrations (db/), CI config and Claude Code settings (.claude/) ship in
# the repo but are not part of the site.
<IfModule mod_alias.c>
  RedirectMatch 404 (?:^|/)(?:tests|tools|db|docs|\.github|\.claude)(?:/|$)
</IfModule>
# Fallback if mod_alias is unavailable: the same folders, plus .git, by mod_rewrite.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (?:^|/)\.git - [R=404,L]
  RewriteRule (?:^|/)(?:tests|tools|db|docs|\.github|\.claude)(?:/|$) - [R=404,L]
</IfModule>

Options -Indexes
